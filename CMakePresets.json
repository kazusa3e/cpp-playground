{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
                "CACHE_DEVELOPMENT_BUILD": "OFF",
                "ENABLE_TESTING": "ON",
                "ENABLE_SANITIZER": "OFF",
                "ENABLE_STRICT_WARNINGS": "OFF"
            }
        },
        {
            "name": "development",
            "inherits": [
                "default"
            ],
            "generator": "Ninja",
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_SANITIZER": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_STRICT_WARNINGS": "ON"
            }
        }
    ]
}
